# Google Maps Search API Key (Serper.dev)
# Get your free key at: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Google Gemini API Key (Free tier via Google AI Studio)
# Get your free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model for Web Extraction (Default: gemini-3.5-flash-lite)
# Options: gemini-3.5-flash-lite, heuristic, llama-3.3-70b-versatile, etc.
LLM_MODEL=gemini-3.5-flash-lite

# Optional Providers
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
